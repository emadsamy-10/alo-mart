# ─────────────────────────────────────────────────────────────────────────────
# ALO MART Storefront — environment
# Copy to `.env.local` for local development. None of these are secrets, but
# they are read on the SERVER only (no NEXT_PUBLIC_ prefix): the browser never
# talks to the API directly in Phase 1.
# ─────────────────────────────────────────────────────────────────────────────

# Public ALO MART API (Laravel), including the /api/v1 prefix.
ALO_API_BASE_URL=https://api.alo-mart.web-apps.site/api/v1

# Request timeout for server-side API calls, in milliseconds.
ALO_API_TIMEOUT_MS=8000

# Canonical origin of THIS website (no trailing slash). Used for canonical
# URLs, hreflang alternates, Open Graph URLs, sitemap.xml and robots.txt.
# Set it to the real hostname of each deployment.
SITE_URL=http://localhost:3000

# Search-engine indexing. Anything other than "true" makes every page
# `noindex, nofollow`, sends `X-Robots-Tag: noindex`, and robots.txt disallows
# everything. Set to "true" ONLY on the real production hostname.
SITE_INDEXABLE=false

# Market used when the visitor has not chosen one (and for crawlers).
# Must be the code of an active market in the API (/markets). The API's own
# default market (SA) currently has no homepage content, so EG is used here.
DEFAULT_MARKET=EG

# Extra hosts allowed for next/image optimisation, comma-separated
# (e.g. a future image CDN). The API host is always allowed.
# Read at BUILD time (next.config.ts).
IMAGE_REMOTE_HOSTS=
